<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Meio.desktop.Controls.BackgroundCircle"
             x:Name="RootBackgroundCircle"
             ClipToBounds="False">
    <Ellipse Width="{Binding #RootBackgroundCircle.Width}"
             Height="{Binding #RootBackgroundCircle.Height}"
             Fill="{Binding #RootBackgroundCircle.Color}">
        <Ellipse.Effect>
            <BlurEffect Radius="80" />
        </Ellipse.Effect>
    </Ellipse>
</UserControl>