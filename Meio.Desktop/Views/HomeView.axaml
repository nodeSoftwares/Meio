<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Meio.desktop.Controls"
             xmlns:views="clr-namespace:Meio.desktop.Views"
             mc:Ignorable="d"
             x:Class="Meio.desktop.Views.HomeView"
             x:DataType="views:HomeView">
    <Grid>
        <controls:Search HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,36,20,0" ZIndex="1" />
        <ScrollViewer VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      IsScrollInertiaEnabled="True">
            <Grid RowDefinitions="Auto, Auto" RowSpacing="107" Margin="170, 36, 0, 0">
                <TextBlock Grid.Row="0" HorizontalAlignment="Left" FontSize="40" FontWeight="Bold" xml:space="preserve">Welcome back,
Evan.</TextBlock>
                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="17">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="17" ClipToBounds="False">
                        <TextBlock FontSize="24" FontWeight="Bold">For You</TextBlock>
                        <controls:CardsList Grid.Row="1" ItemsSource="{Binding DummyCardsList}" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="17">
                        <TextBlock FontSize="24" FontWeight="Bold">For You</TextBlock>
                        <controls:CardsList Grid.Row="1" ItemsSource="{Binding DummyCardsList}" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="17">
                        <TextBlock FontSize="24" FontWeight="Bold">For You</TextBlock>
                        <controls:CardsList Grid.Row="1" ItemsSource="{Binding DummyCardsList}" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="17">
                        <TextBlock FontSize="24" FontWeight="Bold">For You</TextBlock>
                        <controls:CardsList Grid.Row="1" ItemsSource="{Binding DummyCardsList}" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="17">
                        <TextBlock FontSize="24" FontWeight="Bold">For You</TextBlock>
                        <controls:CardsList Grid.Row="1" ItemsSource="{Binding DummyCardsList}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>