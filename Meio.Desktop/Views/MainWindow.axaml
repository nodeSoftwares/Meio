<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Meio.desktop.Views"
        xmlns:controls="clr-namespace:Meio.desktop.Controls"
        xmlns:models="clr-namespace:Meio.desktop.Models"
        mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="768"
        x:Class="Meio.desktop.Views.MainWindow"
        x:DataType="views:MainWindow"
        TransparencyLevelHint="AcrylicBlur"
        Title="Meio">
    <Grid>
        <controls:Background ZIndex="0" />
        <ContentControl Name="MainContent" ZIndex="1" />
        <Border Name="MenuBar" Classes="Menu"
                Width="120" CornerRadius="0,20,20,0"
                VerticalAlignment="Stretch" HorizontalAlignment="Left"
                ZIndex="2"> <!-- Menu Bar -->
            <Grid RowDefinitions="Auto, *" RowSpacing="43" Margin="0, 11, 0, 0"> <!-- Content -->
                <StackPanel Spacing="10"
                            HorizontalAlignment="Center" Orientation="Horizontal"> <!-- Profile|Menu -->
                    <Ellipse Width="50" Height="50" Fill="{DynamicResource PrimaryAccentColor}" />
                    <Svg SvgSource="avares://Meio.desktop/Assets/Icons/menu_hamburger.svg" Width="36" Height="36" />
                </StackPanel> <!-- /Profile|Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                              IsScrollInertiaEnabled="True"> <!-- Playlists -->
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0.0" Color="#00000000" />
                            <GradientStop Offset="0.01" Color="#FF000000" />
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <ItemsControl ItemsSource="{Binding DummyPlaylistCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Width="96" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistCardModel">
                                <controls:SmallCard CoverBrush="{Binding CoverBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer> <!-- /Playlists -->
            </Grid> <!-- /Content -->
        </Border> <!-- /Menu Bar -->
    </Grid>
</Window>